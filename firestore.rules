rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() <= 60;
    }

    // User profiles — own document only (server Admin SDK bypasses rules for ops)
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || true == false);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /chat_history/{messageId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Family ledger is server-owned via Admin SDK. Clients use Express /api/*.
    match /families/{familyId} {
      allow read, write: if false;

      match /{subcollection}/{docId} {
        allow read, write: if false;
      }

      match /{subcollection}/{docId}/{document=**} {
        allow read, write: if false;
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
