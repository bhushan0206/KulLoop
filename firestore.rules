rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'displayName']) &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() <= 60;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /chat_history/{messageId} {
        allow read, write: if true;
      }
    }

    match /families/{familyId} {
      allow read, write: if true;
    }

    match /occasions/{occasionId} {
      allow read, write: if true;
    }

    match /members/{memberId} {
      allow read, write: if true;
    }

    match /lineage/{lineageId} {
      allow read, write: if true;
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
