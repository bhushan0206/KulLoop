# ==============================================================================
# KulLoop Environment Variables
# Copy this file to .env and configure your values.
# ==============================================================================

PORT=3000
APP_URL="http://localhost:3000"

# Live data: server JSON store is canonical (data/kulloop_store.json). Optional Firestore mirror:
# VITE_FIRESTORE_MIRROR=false

# API auth — verify Firebase ID tokens (set REQUIRE_FIREBASE_AUTH=true in production)
# FIREBASE_PROJECT_ID="gen-lang-client-0572007240"
# REQUIRE_FIREBASE_AUTH=false

# Capacitor Android: point the WebView at your deployed site (dev) or leave unset for bundled dist.
# CAPACITOR_SERVER_URL="https://your-kulloop.vercel.app"
# Static Android build calling remote API:
# VITE_API_BASE_URL="https://your-kulloop.vercel.app"

# Reminder worker (email + FCM): runs on interval; disable with ENABLE_REMINDER_CRON=false
# REMINDER_CRON_MS=21600000

# FCM + canonical Firestore (Admin SDK). Place google-services.json in android/app/ for native push.
# FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'   # Vercel: npm run sync:vercel-env
# FIRESTORE_DATABASE_ID=""   # named DB id, or omit for (default)
# CRON_SECRET="long-random-string"
# One-time legacy import: npm run migrate:firestore

# Google Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# SMTP Email Configuration (for automated email reminders)
SMTP_HOST="mail.spacemail.com"
SMTP_PORT=587
SMTP_USER="help@yourdomain.com"
SMTP_PASSWORD="your-secure-smtp-password"
EMAIL_FROM="help@yourdomain.com"
EMAIL_FROM_NAME="KulLoop · Family Ritual Service"

