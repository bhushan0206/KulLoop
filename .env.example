# ==============================================================================
# KulLoop Environment Variables
# Copy this file to .env and configure your values.
# ==============================================================================

# Server Port
PORT=3000

# Google Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App Public URL
APP_URL="http://localhost:3000"

# SMTP Email Configuration (for automated email reminders)
SMTP_HOST="mail.spacemail.com"
SMTP_PORT=587
SMTP_USER="help@yourdomain.com"
SMTP_PASSWORD="your-secure-smtp-password"
EMAIL_FROM="help@yourdomain.com"
EMAIL_FROM_NAME="KulLoop · Family Ritual Service"

# WhatsApp Cloud API / Automated Dispatch (Optional for Production Worker)
# WHATSAPP_API_TOKEN="your-meta-whatsapp-token"
# WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-id"

# Firebase Client Configuration (Optional overrides; defaults load from firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
